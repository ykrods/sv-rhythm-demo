{
  "name": "sv-rhythm-demo",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/stu-bell/devcontainer-features/claude-code:0": {},
    "ghcr.io/shyim/devcontainers-features/bun:0": {}
  },
  "workspaceFolder": "/workspaces/sv-rhythm-demo",
  "remoteUser": "vscode",
  "mounts": [
    "source=devcontainerdemo-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "postCreateCommand": "sudo chown vscode:vscode node_modules && bun install",
  "forwardPorts": [5173],
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode"
      ]
    }
  }
}
